# Restrict replacement to the dedicated asset directory inside this build tree.
get_filename_component(asset_destination "${ASSET_DESTINATION}" REALPATH)
get_filename_component(build_root "${BUILD_ROOT}" REALPATH)
file(TO_CMAKE_PATH "${asset_destination}" asset_destination)
file(TO_CMAKE_PATH "${build_root}" build_root)
string(FIND "${asset_destination}/" "${build_root}/" root_position)
if(NOT root_position EQUAL 0 OR NOT asset_destination MATCHES "/webview/web$")
  message(FATAL_ERROR "Refusing to replace assets outside the build tree: ${asset_destination}")
endif()
if(NOT EXISTS "${ASSET_SOURCE}/index.html")
  message(FATAL_ERROR "WebView asset source is missing")
endif()
file(REMOVE_RECURSE "${asset_destination}")
get_filename_component(asset_parent "${asset_destination}" DIRECTORY)
file(MAKE_DIRECTORY "${asset_parent}")
file(COPY "${ASSET_SOURCE}" DESTINATION "${asset_parent}")
